# PostgreSQL (Django ORM — single source of truth)
POSTGRES_DB=mmh
POSTGRES_USER=mmh
POSTGRES_PASSWORD=mmh_dev_only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# POSTGRES_CONN_MAX_AGE=60

# Django environment: development | staging | production
DJANGO_ENV=development
# Prefer DJANGO_SECRET_KEY in production; SECRET_KEY also accepted
SECRET_KEY=change-me-dev-only-not-for-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS / CSRF — frontend origins (HTTPS in staging/production)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Demo checkout auto-pay (DEVELOPMENT ONLY, opt-in). When true, checkout marks orders PAID and
# issues demo codes without any real payment. Keep false unless demoing fulfillment.
# Production refuses to start if true.
ALLOW_DEMO_AUTO_PAYMENT=false

# AES-256-GCM for digital codes — 64 hex chars. REQUIRED in production/staging.
# Generate: openssl rand -hex 32
# Back up this key separately from the database. Losing it makes codes undecryptable.
CODE_ENCRYPTION_KEY=

# Bootstrap admin (seed_catalog). Empty in production settings by default.
BOOTSTRAP_ADMIN_EMAIL=admin@mmh.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeStrong1!
SEED_DEMO_CUSTOMER=true

# JWT lifetimes (hours / days)
# JWT_ACCESS_HOURS=8
# JWT_REFRESH_DAYS=7

# Logging
# LOG_LEVEL=INFO

# HTTPS (staging/production defaults apply when DJANGO_ENV is staging|production)
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000

# Supplier — keep mock/test; live is hard-locked until payment go-live
SUPPLIER_MODE=mock
ONEEPIN_MODE=test
ONEEPIN_TEST_BASE_URL=https://www.1epin.com/api/test/
ONEEPIN_LIVE_BASE_URL=https://www.1epin.com/api/live/
ONEEPIN_EMAIL=
ONEEPIN_PASSWORD=
ONEEPIN_CALLBACK_TOKEN=
ONEEPIN_RECONCILE_TOKEN=
ONEEPIN_ALLOW_LIVE=false
ONEEPIN_REQUEST_TIMEOUT_MS=15000

# --- Production example (do not commit real values) ---
# DJANGO_ENV=production
# DEBUG=false
# ALLOW_DEMO_AUTO_PAYMENT=false
# SECRET_KEY=<openssl rand -base64 48>
# CODE_ENCRYPTION_KEY=<openssl rand -hex 32>
# ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://www.example.com
# CSRF_TRUSTED_ORIGINS=https://www.example.com,https://api.example.com
# POSTGRES_HOST=<managed-db-host>
# POSTGRES_PASSWORD=<strong-password>
# ONEEPIN_ALLOW_LIVE=false
# SUPPLIER_MODE=mock
