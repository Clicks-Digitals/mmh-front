# MMH backend environment. Every variable config/settings.py reads is listed here.
# Values shown are development defaults; see the "Deployed example" block at the end.

# --- Environment -------------------------------------------------------------
# development | staging | production. Staging is hardened exactly like production.
DJANGO_ENV=development
# REQUIRED in staging/production. DJANGO_SECRET_KEY is accepted as an alias.
SECRET_KEY=change-me-dev-only-not-for-production
# DJANGO_SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=DEBUG

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=mmh
POSTGRES_USER=mmh
POSTGRES_PASSWORD=mmh_dev_only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Defaults: 60 in production, 0 elsewhere
# POSTGRES_CONN_MAX_AGE=60
# Defaults to "require" in production, unset elsewhere (disable|allow|prefer|require|verify-full)
# POSTGRES_SSLMODE=require

# --- CORS / CSRF (frontend origins; HTTPS in staging/production) ---------------
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# --- HTTPS (applied when DJANGO_ENV is staging|production) ---------------------
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=false
# Trusted reverse proxies in front of gunicorn (client IP for throttling). Default 1 when deployed.
# DRF_NUM_PROXIES=1

# --- Public site / support -------------------------------------------------------
# Storefront origin used in emails (password reset link: {SITE_URL}/reset-password?uid=..&token=..)
SITE_URL=https://www.mmhcard.com
SUPPORT_EMAIL=

# --- Email -----------------------------------------------------------------------
# When EMAIL_HOST is empty, emails go to the console (a warning is logged in staging/production).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=MMH <no-reply@mmhcard.com>

# --- Media -------------------------------------------------------------------------
# Uploaded images. On Railway mount a volume at /data/media and set MEDIA_ROOT=/data/media.
# MEDIA_ROOT=./media
# Cache-Control max-age for served media (seconds, default 30 days)
# MEDIA_CACHE_SECONDS=2592000

# --- Django admin (/django-admin/) — default true in development only -------------------
# DJANGO_ADMIN_ENABLED=false

# --- Error reporting -------------------------------------------------------------------
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Container mode (scripts/entrypoint.sh) ------------------------------------------
# web (default): migrate + createcachetable + collectstatic + gunicorn
# jobs: run `manage.py run_scheduled_jobs` once and exit (Railway cron service)
# RUN_MODE=web
# PORT=8000
# WEB_CONCURRENCY=2

# --- Throttling (optional overrides; empty value disables a limit) ----------------------
# THROTTLE_ANON_RATE=120/min          # anonymous POST/PUT/PATCH/DELETE per IP
# THROTTLE_ANON_READ_RATE=            # anonymous GETs per IP (off by default: SSR shares IPs)
# THROTTLE_USER_RATE=300/min
# THROTTLE_LOGIN_RATE=10/min
# THROTTLE_REGISTER_RATE=5/hour
# THROTTLE_PASSWORD_RESET_RATE=5/hour
# THROTTLE_PASSWORD_RESET_CONFIRM_RATE=20/hour
# THROTTLE_TOKEN_REFRESH_RATE=60/min
# THROTTLE_CHANGE_PASSWORD_RATE=10/hour   # POST /auth/change-password/ per user
# THROTTLE_LOGOUT_RATE=30/min
# THROTTLE_COUPON_RATE=20/min
# THROTTLE_CHECKOUT_RATE=30/hour
# THROTTLE_ORDER_LOOKUP_RATE=30/min
# THROTTLE_CODE_REVEAL_RATE=20/hour
# THROTTLE_PAYPAL_RATE=60/hour
# THROTTLE_CONTACT_RATE=10/hour
# THROTTLE_SUPPLIER_CALLBACK_RATE=120/min

# --- Demo / seed (development) -----------------------------------------------------------
# Demo checkout auto-pay. DEVELOPMENT ONLY; production refuses to start if true.
ALLOW_DEMO_AUTO_PAYMENT=false
# Bootstrap admin used by seed_catalog (empty by default outside development).
BOOTSTRAP_ADMIN_EMAIL=admin@mmh.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeStrong1!
# Demo customer + MMH10 coupon are only seeded when DJANGO_ENV=development.
SEED_DEMO_CUSTOMER=true

# --- Codes encryption --------------------------------------------------------------------
# AES-256-GCM key: 64 hex chars. REQUIRED in staging and production. Generate: openssl rand -hex 32
# Back it up separately from the database. Losing it makes stored codes undecryptable.
CODE_ENCRYPTION_KEY=

# --- JWT -----------------------------------------------------------------------------------
# Refresh tokens rotate on every refresh and the old one is blacklisted.
# JWT_ACCESS_HOURS=8
# JWT_REFRESH_DAYS=7

# --- PayPal Orders v2 (secret is server-only) -------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Events: PAYMENT.CAPTURE.COMPLETED, .DENIED, .REFUNDED, .REVERSED (optionally CHECKOUT.ORDER.COMPLETED)
PAYPAL_WEBHOOK_ID=
# Settlement currency. The sandbox app rejects JOD, so development uses USD.
PAYPAL_CURRENCY=USD
# PayPal major units per 1 JOD (required when PAYPAL_CURRENCY is not JOD). 1 JOD = 1/0.709 USD.
PAYPAL_FX_RATE=1.4104372355429464
PAYPAL_BRAND_NAME=MMH
PAYPAL_TIMEOUT_SECONDS=20

# --- Supplier (1Epin) - see README "1Epin integration" -----------------------------------
# mock = simulated 1Epin (fake PINs, development only) | test = 1Epin test API | live = real purchases
SUPPLIER_MODE=mock
# Live needs BOTH SUPPLIER_MODE=live and ONEEPIN_ALLOW_LIVE=true.
ONEEPIN_ALLOW_LIVE=false
ONEEPIN_TEST_BASE_URL=https://www.1epin.com/api/test/
ONEEPIN_LIVE_BASE_URL=https://www.1epin.com/api/live/
# 1epin.com account (test mode may use test@1epin.com or test_usd@1epin.com / test1234). Never logged.
ONEEPIN_EMAIL=
ONEEPIN_PASSWORD=
# Callback URL to register on https://www.1epin.com/api-ayarlari:
#   <PUBLIC_API_URL>/api/v1/suppliers/1epin/callback/<ONEEPIN_CALLBACK_TOKEN>/   (token: openssl rand -hex 24)
ONEEPIN_CALLBACK_TOKEN=
ONEEPIN_RECONCILE_TOKEN=
PUBLIC_API_URL=https://backend-production-8e0e1e.up.railway.app
ONEEPIN_REQUEST_TIMEOUT_MS=15000
# Optional static-IP egress proxy for every 1Epin call (hosts without a static outbound IP):
# ONEEPIN_HTTP_PROXY=http://user:pass@static-ip-proxy.example.com:8080
ONEEPIN_HTTP_PROXY=
ONEEPIN_IP_LOOKUP_URL=https://api.ipify.org?format=json
# Wallet currency and JOD per 1 unit of it (USD -> 0.709).
ONEEPIN_CURRENCY=USD
ONEEPIN_FX_TO_JOD=0.709
# Low-balance warning threshold (wallet currency).
ONEEPIN_LOW_BALANCE=20
# Let mappings count as stock in test/mock mode (staging rehearsals). Live always counts.
ONEEPIN_TEST_COUNTS_AS_STOCK=false
# Mock mode may "buy" (fake PINs) only in development; forced off in staging/production.
ONEEPIN_MOCK_FULFILLMENT=true
# Place 1Epin orders right after payment commits (false = scheduled job only).
ONEEPIN_INLINE_FULFILLMENT=true

# --- Deployed example (do not commit real values) ------------------------------------------
# DJANGO_ENV=production
# DEBUG=false
# SECRET_KEY=<openssl rand -base64 48>
# CODE_ENCRYPTION_KEY=<openssl rand -hex 32>
# ALLOWED_HOSTS=api.mmhcard.com,healthcheck.railway.app
# CORS_ALLOWED_ORIGINS=https://www.mmhcard.com
# CSRF_TRUSTED_ORIGINS=https://www.mmhcard.com,https://api.mmhcard.com
# SITE_URL=https://www.mmhcard.com
# MEDIA_ROOT=/data/media
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# SENTRY_DSN=...
# DJANGO_ADMIN_ENABLED=false
# ALLOW_DEMO_AUTO_PAYMENT=false
# ONEEPIN_ALLOW_LIVE=false
